# .env file for timetable_updater
# Copy this file to .env and fill in your credentials

SCHOOL_USERNAME=your_school_username
SCHOOL_PASSWORD=your_school_password
# Optionally, set a specific semester (leave blank for current)
# Values: 136=HK1/2026-2027, 137=HK2/2026-2027, etc.
TIMETABLE_SEMESTER=
# Optionally, set a specific week (leave blank for current week)
TIMETABLE_WEEK=
# Path to Google API credentials (if not using GitHub Secrets)
GOOGLE_CREDENTIALS=credentials.json
# Google Calendar ID to sync to (default: primary)
GOOGLE_CALENDAR_ID=primary
# Number of weeks to scrape by default (not --full)
CRAWLER_WEEKS_AHEAD=2
# Google Calendar event colors (IDs 1-11: https://developers.google.com/calendar/api/v3/reference/colors/get)
CALENDAR_COLOR_CLASS=2   # Light blue
CALENDAR_COLOR_EXAM=11   # Tomato red
CALENDAR_COLOR_GRAPHITE=8   # Gray - for "GV báo vắng" (teacher absent)
CALENDAR_COLOR_BASIL=10   # Light green - for "GV dạy bù" (make-up class)
