# .env file for timetable_updater
# Copy this file to .env and fill in your credentials

SCHOOL_USERNAME=your_student_id
SCHOOL_PASSWORD=your_portal_password

# Optional: set a specific semester (leave blank for current active semester)
# Values: 136=HK1/2026-2027, 137=HK2/2026-2027, etc.
TIMETABLE_SEMESTER=

# Google Service Account authentication
# Local development: path to service account json file
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
GOOGLE_CREDENTIALS=credentials.json

# CI / GitHub Actions: full JSON content of service account
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# Google Calendar ID to sync to (e.g. primary or your-calendar-id@group.calendar.google.com)
GOOGLE_CALENDAR_ID=primary

# Number of weeks to scrape ahead by default (default: 2 = current + next week)
CRAWLER_WEEKS_AHEAD=2

# Google Calendar event colors (IDs 1-11: https://developers.google.com/calendar/api/v3/reference/colors/get)
CALENDAR_COLOR_CLASS=2       # Light blue
CALENDAR_COLOR_EXAM=11       # Tomato red
CALENDAR_COLOR_GRAPHITE=8    # Gray - for absent teacher ("GV báo vắng")
CALENDAR_COLOR_BASIL=10      # Light green - for makeup class ("GV dạy bù")

# SQLite sync audit log path (default: sync_history.db)
SYNC_DB_PATH=sync_history.db

